#!/usr/bin/env swift
import AppKit
import Foundation

let fileManager = FileManager.default
let currentDirectory = URL(fileURLWithPath: fileManager.currentDirectoryPath, isDirectory: true)
let scriptURL = URL(fileURLWithPath: CommandLine.arguments[0], relativeTo: currentDirectory).standardizedFileURL
let repoRoot = scriptURL.deletingLastPathComponent().deletingLastPathComponent()
let resourcesURL = repoRoot.appendingPathComponent("Resources", isDirectory: true)
let iconsetURL = resourcesURL.appendingPathComponent("AppIcon.iconset", isDirectory: true)
let icnsURL = resourcesURL.appendingPathComponent("AppIcon.icns")
let previewURL = resourcesURL.appendingPathComponent("AppIcon.preview.png")

try fileManager.createDirectory(at: resourcesURL, withIntermediateDirectories: true)
if fileManager.fileExists(atPath: iconsetURL.path) {
    try fileManager.removeItem(at: iconsetURL)
}
try fileManager.createDirectory(at: iconsetURL, withIntermediateDirectories: true)

func color(_ red: CGFloat, _ green: CGFloat, _ blue: CGFloat, _ alpha: CGFloat = 1) -> NSColor {
    NSColor(calibratedRed: red / 255, green: green / 255, blue: blue / 255, alpha: alpha)
}

func roundedRect(_ rect: NSRect, radius: CGFloat) -> NSBezierPath {
    NSBezierPath(roundedRect: rect, xRadius: radius, yRadius: radius)
}

func fill(_ path: NSBezierPath, _ color: NSColor) {
    color.setFill()
    path.fill()
}

func stroke(_ path: NSBezierPath, _ color: NSColor, width: CGFloat, lineCap: NSBezierPath.LineCapStyle = .round) {
    color.setStroke()
    path.lineWidth = width
    path.lineCapStyle = lineCap
    path.stroke()
}

func line(from start: NSPoint, to end: NSPoint, color: NSColor, width: CGFloat) {
    let path = NSBezierPath()
    path.move(to: start)
    path.line(to: end)
    stroke(path, color, width: width)
}

func circle(center: NSPoint, radius: CGFloat, color: NSColor) {
    fill(NSBezierPath(ovalIn: NSRect(x: center.x - radius, y: center.y - radius, width: radius * 2, height: radius * 2)), color)
}

func drawIcon(size: CGFloat) throws -> NSBitmapImageRep {
    guard let rep = NSBitmapImageRep(
        bitmapDataPlanes: nil,
        pixelsWide: Int(size),
        pixelsHigh: Int(size),
        bitsPerSample: 8,
        samplesPerPixel: 4,
        hasAlpha: true,
        isPlanar: false,
        colorSpaceName: .deviceRGB,
        bytesPerRow: 0,
        bitsPerPixel: 0
    ) else {
        throw NSError(domain: "Icon", code: 1, userInfo: [NSLocalizedDescriptionKey: "Could not allocate bitmap"])
    }

    rep.size = NSSize(width: size, height: size)
    NSGraphicsContext.saveGraphicsState()
    guard let context = NSGraphicsContext(bitmapImageRep: rep) else {
        throw NSError(domain: "Icon", code: 2, userInfo: [NSLocalizedDescriptionKey: "Could not create graphics context"])
    }
    NSGraphicsContext.current = context
    context.cgContext.setShouldAntialias(true)
    context.cgContext.scaleBy(x: size / 1024, y: size / 1024)

    NSColor.clear.setFill()
    NSRect(x: 0, y: 0, width: 1024, height: 1024).fill()

    let baseRect = NSRect(x: 72, y: 72, width: 880, height: 880)
    let basePath = roundedRect(baseRect, radius: 198)

    let outerShadow = NSShadow()
    outerShadow.shadowColor = NSColor.black.withAlphaComponent(0.34)
    outerShadow.shadowBlurRadius = 48
    outerShadow.shadowOffset = NSSize(width: 0, height: -20)
    outerShadow.set()
    fill(basePath, color(6, 16, 36))
    NSShadow().set()

    basePath.addClip()
    NSGradient(colors: [
        color(9, 28, 62),
        color(6, 72, 91),
        color(21, 35, 78),
    ])?.draw(in: baseRect, angle: -34)

    for offset in stride(from: -620, through: 980, by: 96) {
        line(
            from: NSPoint(x: CGFloat(offset), y: 150),
            to: NSPoint(x: CGFloat(offset) + 700, y: 920),
            color: color(104, 227, 255, 0.08),
            width: 3
        )
    }
    for y in stride(from: 190, through: 820, by: 86) {
        line(from: NSPoint(x: 155, y: CGFloat(y)), to: NSPoint(x: 870, y: CGFloat(y)), color: color(255, 255, 255, 0.055), width: 2)
    }

    let glowPath = NSBezierPath()
    glowPath.move(to: NSPoint(x: 782, y: 844))
    glowPath.curve(
        to: NSPoint(x: 894, y: 654),
        controlPoint1: NSPoint(x: 902, y: 810),
        controlPoint2: NSPoint(x: 936, y: 718)
    )
    stroke(glowPath, color(70, 240, 220, 0.18), width: 28)
    stroke(glowPath, color(70, 240, 220, 0.34), width: 9)

    let windowRect = NSRect(x: 178, y: 230, width: 668, height: 554)
    let windowPath = roundedRect(windowRect, radius: 76)
    let windowShadow = NSShadow()
    windowShadow.shadowColor = NSColor.black.withAlphaComponent(0.32)
    windowShadow.shadowBlurRadius = 32
    windowShadow.shadowOffset = NSSize(width: 0, height: -14)
    windowShadow.set()
    fill(windowPath, color(10, 20, 39))
    NSShadow().set()
    stroke(windowPath, color(129, 229, 255, 0.42), width: 5)

    let titleBar = roundedRect(NSRect(x: 206, y: 676, width: 612, height: 76), radius: 38)
    fill(titleBar, color(230, 248, 255, 0.12))
    circle(center: NSPoint(x: 258, y: 714), radius: 13, color: color(87, 236, 210))
    circle(center: NSPoint(x: 305, y: 714), radius: 13, color: color(250, 198, 82))
    circle(center: NSPoint(x: 352, y: 714), radius: 13, color: color(171, 132, 255))
    line(from: NSPoint(x: 418, y: 714), to: NSPoint(x: 762, y: 714), color: color(230, 248, 255, 0.16), width: 10)

    let leftPane = roundedRect(NSRect(x: 226, y: 308, width: 266, height: 330), radius: 34)
    let rightPane = roundedRect(NSRect(x: 532, y: 308, width: 266, height: 330), radius: 34)
    fill(leftPane, color(4, 14, 27, 0.92))
    fill(rightPane, color(4, 14, 27, 0.92))
    stroke(leftPane, color(108, 222, 255, 0.26), width: 3)
    stroke(rightPane, color(255, 204, 94, 0.26), width: 3)

    line(from: NSPoint(x: 512, y: 318), to: NSPoint(x: 512, y: 628), color: color(231, 246, 255, 0.16), width: 4)

    line(from: NSPoint(x: 288, y: 556), to: NSPoint(x: 330, y: 518), color: color(74, 238, 219), width: 13)
    line(from: NSPoint(x: 288, y: 480), to: NSPoint(x: 330, y: 518), color: color(74, 238, 219), width: 13)
    line(from: NSPoint(x: 360, y: 518), to: NSPoint(x: 440, y: 518), color: color(120, 231, 255), width: 11)
    line(from: NSPoint(x: 286, y: 424), to: NSPoint(x: 430, y: 424), color: color(108, 222, 255, 0.48), width: 10)
    line(from: NSPoint(x: 286, y: 384), to: NSPoint(x: 394, y: 384), color: color(165, 132, 255, 0.48), width: 10)

    line(from: NSPoint(x: 616, y: 548), to: NSPoint(x: 702, y: 488), color: color(252, 198, 82, 0.72), width: 9)
    circle(center: NSPoint(x: 616, y: 548), radius: 24, color: color(75, 235, 218))
    circle(center: NSPoint(x: 702, y: 488), radius: 24, color: color(252, 198, 82))
    circle(center: NSPoint(x: 638, y: 404), radius: 18, color: color(171, 132, 255))
    line(from: NSPoint(x: 638, y: 404), to: NSPoint(x: 702, y: 488), color: color(171, 132, 255, 0.42), width: 8)

    let playGlow = NSBezierPath(ovalIn: NSRect(x: 420, y: 384, width: 184, height: 184))
    fill(playGlow, color(63, 238, 222, 0.16))
    let play = NSBezierPath()
    play.move(to: NSPoint(x: 478, y: 424))
    play.line(to: NSPoint(x: 478, y: 548))
    play.line(to: NSPoint(x: 588, y: 486))
    play.close()
    fill(play, color(235, 253, 255))
    stroke(play, color(85, 242, 222, 0.86), width: 5, lineCap: .round)

    let bottomDock = roundedRect(NSRect(x: 348, y: 152, width: 328, height: 58), radius: 29)
    fill(bottomDock, color(255, 255, 255, 0.12))
    circle(center: NSPoint(x: 414, y: 181), radius: 12, color: color(75, 235, 218))
    circle(center: NSPoint(x: 512, y: 181), radius: 12, color: color(250, 198, 82))
    circle(center: NSPoint(x: 610, y: 181), radius: 12, color: color(171, 132, 255))

    NSGraphicsContext.restoreGraphicsState()
    return rep
}

func writePNG(size: CGFloat, name: String) throws {
    let rep = try drawIcon(size: size)
    guard let data = rep.representation(using: .png, properties: [:]) else {
        throw NSError(domain: "Icon", code: 3, userInfo: [NSLocalizedDescriptionKey: "Could not encode PNG"])
    }
    try data.write(to: iconsetURL.appendingPathComponent(name))
    if size == 1024 {
        try data.write(to: previewURL)
    }
}

let icons: [(String, CGFloat)] = [
    ("icon_16x16.png", 16),
    ("icon_16x16@2x.png", 32),
    ("icon_32x32.png", 32),
    ("icon_32x32@2x.png", 64),
    ("icon_128x128.png", 128),
    ("icon_128x128@2x.png", 256),
    ("icon_256x256.png", 256),
    ("icon_256x256@2x.png", 512),
    ("icon_512x512.png", 512),
    ("icon_512x512@2x.png", 1024),
]

for icon in icons {
    try writePNG(size: icon.1, name: icon.0)
}

let iconutil = Process()
iconutil.executableURL = URL(fileURLWithPath: "/usr/bin/iconutil")
iconutil.arguments = ["-c", "icns", iconsetURL.path, "-o", icnsURL.path]
try iconutil.run()
iconutil.waitUntilExit()

guard iconutil.terminationStatus == 0 else {
    throw NSError(domain: "Icon", code: Int(iconutil.terminationStatus), userInfo: [NSLocalizedDescriptionKey: "iconutil failed"])
}

try fileManager.removeItem(at: iconsetURL)
print(icnsURL.path)
