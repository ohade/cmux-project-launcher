#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
Usage: cmux-project-launch [--no-start] <project>

Creates a cmux workspace with one pane per chosen agent (by default Codex and
Claude; see CMUX_PROJECT_LAUNCHER_AGENTS below), names each Codex and Claude
session after the project (Claude via `claude --name claude-<project>` at boot,
Codex via a post-boot `/rename codex-<project>`), then sends:
  Codex: $start <project>
  Claude: /start <project>

With --no-start (used for ad-hoc scratch workspaces), the workspace is created and
the sessions are renamed, but neither /start is sent. In that mode the workspace is
the deliverable: readiness and rename are best-effort and never discard the
workspace on failure. A ready agent still gets its exact AMQ wake, and an agent
left without one fails the launch (non-zero exit) while the workspace is kept.

CMUX_PROJECT_LAUNCHER_AGENTS chooses the agents, one pane each (up to five). Only
Codex and Claude are named, attached and started as above. Grok, Gemini and Codex
on Cursor start through coopgrok, coopgemini and coopcursorcodex exactly as typed;
their own bootstrap names them and attaches their wake, and the launcher only
waits until that wake is bound to their exact pane. They get no start prompt.

Without CMUX_PROJECT_LAUNCHER_AGENTS an existing AMQ room keeps its agents, and a
new room starts with CMUX_PROJECT_LAUNCHER_DEFAULT_AGENTS. A chosen agent the room
lacks is added to the room before the workspace is created.

Environment:
  CMUX_PROJECT_LAUNCHER_AGENTS   comma-separated agents to launch, any order:
                                  claude, codex, grok, gemini, cursorcodex
  CMUX_PROJECT_LAUNCHER_DEFAULT_AGENTS
                                  agents for a new room (default: claude,codex)
  CMUX_PROJECT_LAUNCHER_CMUX     cmux CLI path
  CMUX_PROJECT_LAUNCHER_WAIT     seconds to wait before post-boot sends (default: 8)
  CMUX_PROJECT_LAUNCHER_POLL     seconds to poll read-screen before fallback (default: 150)
  CMUX_PROJECT_LAUNCHER_CODEX_READY_REGEX
                                  readiness regex for Codex read-screen polling
  CMUX_PROJECT_LAUNCHER_CLAUDE_READY_REGEX
                                  readiness regex for Claude read-screen polling
  CMUX_PROJECT_LAUNCHER_PROMOTE_WAIT
                                  seconds to poll after one focus/refresh promotion attempt
  CMUX_PROJECT_LAUNCHER_ENTER_DELAY
                                  seconds between prompt text send and Enter key (default: 0.5)
  CMUX_PROJECT_LAUNCHER_ENTER_RETRIES
                                  Enter key attempts while confirming submit (default: 3)
  CMUX_PROJECT_LAUNCHER_SUBMIT_CONFIRM_WAIT
                                  seconds to wait after each Enter for submit proof (default: 4)
  CMUX_PROJECT_LAUNCHER_KEEP_FAILED_WORKSPACE
                                  keep a failed cmux workspace for debugging
  CMUX_PROJECT_LAUNCHER_AMQ_ROOT  AMQ base root for session allocation
  CMUX_PROJECT_LAUNCHER_AMQ       AMQ CLI path for session allocation
  CMUX_PROJECT_LAUNCHER_KEEPALIVE amq-keepalive path for exact attach and safe retirement
  CMUX_PROJECT_LAUNCHER_AMQ_PATH_HINTS
                                  colon-separated AMQ paths or dirs for GUI PATH fallback
  CMUX_PROJECT_LAUNCHER_WORKSPACE_ROOT
                                  workspace root for coop launchers (default: ~/git)
  CMUX_PROJECT_LAUNCHER_CODEX_LAUNCHER
                                  Codex shell function or executable (default: amq_codex)
  CMUX_PROJECT_LAUNCHER_CLAUDE_LAUNCHER
                                  Claude shell function or executable (default: amq_claude)
  CMUX_PROJECT_LAUNCHER_GROK_LAUNCHER
                                  Grok coop helper (default: coopgrok)
  CMUX_PROJECT_LAUNCHER_GEMINI_LAUNCHER
                                  Gemini coop helper (default: coopgemini)
  CMUX_PROJECT_LAUNCHER_CURSORCODEX_LAUNCHER
                                  Codex on Cursor coop helper (default: coopcursorcodex)
  CMUX_PROJECT_LAUNCHER_OPEN      open CLI path for app activation
  CMUX_PROJECT_LAUNCHER_PS        ps CLI path for live agent-process checks
  CMUX_PROJECT_LAUNCHER_LOG       persistent diagnostics log path
  CMUX_PROJECT_LAUNCHER_DRY_RUN  print planned commands without launching
USAGE
}

no_start=0
positional=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 2
      ;;
    --no-start)
      no_start=1
      shift
      ;;
    --)
      shift
      while [[ $# -gt 0 ]]; do
        positional+=("$1")
        shift
      done
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage
      exit 2
      ;;
    *)
      positional+=("$1")
      shift
      ;;
  esac
done

if [[ "${#positional[@]}" -ne 1 ]]; then
  usage
  exit 2
fi

project="${positional[0]}"
if [[ ! "$project" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
  echo "Invalid project name: $project" >&2
  exit 2
fi

cmux_bin="${CMUX_PROJECT_LAUNCHER_CMUX:-/Applications/cmux.app/Contents/Resources/bin/cmux}"
amq_bin="${CMUX_PROJECT_LAUNCHER_AMQ:-amq}"
keepalive_bin="${CMUX_PROJECT_LAUNCHER_KEEPALIVE:-$HOME/bin/amq-keepalive}"
open_bin="${CMUX_PROJECT_LAUNCHER_OPEN:-/usr/bin/open}"
ps_bin="${CMUX_PROJECT_LAUNCHER_PS:-/bin/ps}"
workspace_root="${CMUX_PROJECT_LAUNCHER_WORKSPACE_ROOT:-$HOME/git}"
codex_launcher="${CMUX_PROJECT_LAUNCHER_CODEX_LAUNCHER:-amq_codex}"
claude_launcher="${CMUX_PROJECT_LAUNCHER_CLAUDE_LAUNCHER:-amq_claude}"
grok_launcher="${CMUX_PROJECT_LAUNCHER_GROK_LAUNCHER:-coopgrok}"
gemini_launcher="${CMUX_PROJECT_LAUNCHER_GEMINI_LAUNCHER:-coopgemini}"
cursorcodex_launcher="${CMUX_PROJECT_LAUNCHER_CURSORCODEX_LAUNCHER:-coopcursorcodex}"
wait_seconds="${CMUX_PROJECT_LAUNCHER_WAIT:-8}"
# 45s is too short for a FRESH ad-hoc workspace. Measured 2026-09-08: at 45 the
# launcher reports "surface did not become ready" and registers ZERO keepalive rows;
# at 150 both agents come up and register one row each. An agent started in a split of
# an EXISTING workspace is ready in ~1s, which is why this went unnoticed — the cold
# path is the slow one and the ad-hoc launcher always takes it.
poll_seconds="${CMUX_PROJECT_LAUNCHER_POLL:-150}"
promote_wait_seconds="${CMUX_PROJECT_LAUNCHER_PROMOTE_WAIT:-5}"
enter_delay_seconds="${CMUX_PROJECT_LAUNCHER_ENTER_DELAY:-0.5}"
enter_retries="${CMUX_PROJECT_LAUNCHER_ENTER_RETRIES:-3}"
submit_confirm_wait_seconds="${CMUX_PROJECT_LAUNCHER_SUBMIT_CONFIRM_WAIT:-4}"
input_probe_lines="${CMUX_PROJECT_LAUNCHER_INPUT_LINES:-18}"
keep_failed_workspace="${CMUX_PROJECT_LAUNCHER_KEEP_FAILED_WORKSPACE:-0}"
dry_run="${CMUX_PROJECT_LAUNCHER_DRY_RUN:-0}"
diagnostics_log="${CMUX_PROJECT_LAUNCHER_LOG:-$HOME/Library/Logs/CmuxProjectLauncher/launcher.log}"
workspace_ref=""
# Live growth: set when an existing workspace only lacks chosen agents' panes.
grow_workspace_ref=""
grow_amq_session=""
growing_workspace=0
grow_added_surfaces=()
launch_ok=0
reuse_project_session=0
project_lock_file=""
project_lock_acquired=0
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=bin/lib/cmux-project-common.sh
source "$script_dir/lib/cmux-project-common.sh"

# Stored as $codex_ready_regex and $claude_ready_regex; the pipeline reads them per
# agent through agent_var_get.
agent_var_set codex ready_regex "${CMUX_PROJECT_LAUNCHER_CODEX_READY_REGEX:-OpenAI Codex|gpt-[0-9][^[:space:]]*[[:space:]].*Ready|Ready.*gpt-[0-9]}"
agent_var_set claude ready_regex "${CMUX_PROJECT_LAUNCHER_CLAUDE_READY_REGEX:-Claude Code|Welcome to Claude|Opus [0-9]|Sonnet [0-9]|bypass permissions}"

# CMUX_PROJECT_LAUNCHER_AGENTS is the project's own agent choice. Without one the
# agents are resolved once the AMQ root is known (resolve_launch_agents): an
# existing room keeps its agents, and a new room starts with
# CMUX_PROJECT_LAUNCHER_DEFAULT_AGENTS. An explicitly empty value is a caller
# bug, not a request for the default, so it is rejected like any other unusable
# list. This is a usage error, so it is reported before setup_diagnostics_log
# routes stderr through tee: a 2026-10-04 load probe lost this message in 2 of
# 150 exits because the tee child had not written it when the caller read stderr.
agent_choice_explicit=0
if [[ -n "${CMUX_PROJECT_LAUNCHER_AGENTS+x}" ]]; then
  if ! parse_agent_roster "$CMUX_PROJECT_LAUNCHER_AGENTS"; then
    echo "CMUX_PROJECT_LAUNCHER_AGENTS is not a usable agent list: $(agent_roster_reason). Choose one or more of: ${known_agents_roster[*]}. Created nothing." >&2
    exit 2
  fi
  agent_choice_explicit=1
else
  # Provisional until resolve_launch_agents runs, before any AMQ or cmux change.
  parse_agent_roster claude,codex
fi

setup_diagnostics_log() {
  local log_dir
  log_dir="$(dirname "$diagnostics_log")"
  mkdir -p "$log_dir" 2>/dev/null || return 0
  if [[ -f "$diagnostics_log" ]] && [[ "$(wc -c <"$diagnostics_log" 2>/dev/null || printf '0')" -ge 2097152 ]]; then
    mv -f "$diagnostics_log" "${diagnostics_log}.1" 2>/dev/null || true
  fi
  : >>"$diagnostics_log" 2>/dev/null || return 0
  chmod 600 "$diagnostics_log" 2>/dev/null || return 0
  printf '[%s] cmux-project-launch %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$project" >>"$diagnostics_log"
  exec 3>&2
  exec 2> >(tee -a "$diagnostics_log" >&3)
}

setup_diagnostics_log
if ! resolve_amq_bin; then
  echo "AMQ CLI resolution failed before workspace creation. Requested: ${CMUX_PROJECT_LAUNCHER_AMQ:-amq}; hints: ${CMUX_PROJECT_LAUNCHER_AMQ_PATH_HINTS:-<none>}; PATH: $PATH. Set CMUX_PROJECT_LAUNCHER_AMQ to an executable path or configure CMUX_PROJECT_LAUNCHER_AMQ_PATH_HINTS." >&2
  exit 1
fi
workspace_root="$(expand_path "$workspace_root")"
validate_launcher_word "$codex_launcher" "CMUX_PROJECT_LAUNCHER_CODEX_LAUNCHER"
validate_launcher_word "$claude_launcher" "CMUX_PROJECT_LAUNCHER_CLAUDE_LAUNCHER"
validate_launcher_word "$grok_launcher" "CMUX_PROJECT_LAUNCHER_GROK_LAUNCHER"
validate_launcher_word "$gemini_launcher" "CMUX_PROJECT_LAUNCHER_GEMINI_LAUNCHER"
validate_launcher_word "$cursorcodex_launcher" "CMUX_PROJECT_LAUNCHER_CURSORCODEX_LAUNCHER"
keepalive_bin="$(expand_path "$keepalive_bin")"

release_project_launch_lock() {
  local recorded_pid=""
  if [[ "$project_lock_acquired" -ne 1 || -z "$project_lock_file" ]]; then
    return 0
  fi
  if [[ -f "$project_lock_file" ]]; then
    recorded_pid="$(sed -n '1p' "$project_lock_file" 2>/dev/null || true)"
    if [[ "$recorded_pid" == "$$" ]]; then
      rm -f "$project_lock_file"
    fi
  fi
  project_lock_acquired=0
}

acquire_project_launch_lock() {
  local lock_dir="$amq_base_root/.cmux-project-launcher-locks"
  if [[ "$dry_run" == "1" || "$dry_run" == "true" ]]; then
    return 0
  fi
  if [[ ! -x /usr/bin/shlock ]]; then
    echo "Project launch serialization helper is unavailable: /usr/bin/shlock" >&2
    return 1
  fi
  if ! mkdir -p "$lock_dir" || ! chmod 700 "$lock_dir"; then
    echo "Could not prepare project launch lock directory: $lock_dir" >&2
    return 1
  fi
  project_lock_file="$lock_dir/$project.lock"
  # 2026-08-09: two launchers could both observe no config/workspace, initialize
  # the same AMQ root, and create duplicate cmux workspaces. shlock atomically
  # rejects the second launch and removes a stale lock whose PID is no longer live.
  if ! /usr/bin/shlock -f "$project_lock_file" -p "$$"; then
    echo "A cmux project launch for $project is already in progress; created nothing." >&2
    return 1
  fi
  project_lock_acquired=1
}

cleanup_failed_workspace() {
  local status=$?
  local close_output=""
  local cleanup_agents=""
  local added_surface
  local added_closed=1
  trap - EXIT
  if [[ "$status" -ne 0 && "$launch_ok" -ne 1 && -n "${workspace_ref:-}" && "$keep_failed_workspace" != "1" && "$keep_failed_workspace" != "true" ]]; then
    if [[ "$growing_workspace" -eq 1 ]]; then
      # Growth never closes the live workspace. Only the panes this run added
      # are closed, and only the agents added to them are retired.
      if [[ "${#grow_added_surfaces[@]}" -gt 0 ]]; then
        for added_surface in "${grow_added_surfaces[@]}"; do
          if ! close_output="$("$cmux_bin" close-surface --workspace "$workspace_ref" --surface "$added_surface" 2>&1)"; then
            echo "Failed to close the added pane $added_surface in $workspace_ref: $close_output" >&2
            added_closed=0
          fi
        done
        if [[ "$added_closed" -eq 1 && -n "${amq_session:-}" ]]; then
          retire_amq_session "$amq_session" "$launch_retire_csv" || \
            echo "Failed to retire AMQ wakes for the agents added to session $amq_session; the defect remains unresolved." >&2
        fi
      fi
    elif ! close_output="$("$cmux_bin" workspace close "$workspace_ref" 2>&1)"; then
      echo "Failed to close unsuccessful cmux workspace $workspace_ref: $close_output" >&2
    else
      # Retirement is identity-safe and fail-closed, so conservatively attempt
      # every launched identity after a failed workspace has been closed rather
      # than infer partial attachment from the failure phase.
      if [[ -n "${amq_session:-}" ]]; then
        cleanup_agents="$launch_retire_csv"
        retire_amq_session "$amq_session" "$cleanup_agents" || \
          echo "Failed to retire AMQ wakes for unsuccessful session $amq_session; the defect remains unresolved." >&2
      fi
    fi
  fi
  release_project_launch_lock
  exit "$status"
}
trap cleanup_failed_workspace EXIT

if [[ ! -x "$cmux_bin" ]]; then
  echo "cmux CLI not executable: $cmux_bin" >&2
  exit 1
fi

existing_agent_health_reason=""
# Chosen agents with no pane at all in the checked workspace. A workspace whose
# other chosen agents are healthy gets a pane for each of them (live growth).
existing_missing_agents=()
existing_workspace_agents_ready() {
  local target_workspace_ref="$1"
  local target_amq_session="$2"
  local pane_rows
  local pane_surface_rows
  local pane_ref
  local surface_rows
  local process_status
  local row
  local agent
  local agent_name
  local wake_status
  local expected_surfaces=""
  local surfaces_unique=1
  local -a pane_refs
  local -a all_surface_rows
  local -a agent_refs
  local -a agent_ids
  local -a present_agents
  pane_refs=()
  all_surface_rows=()
  present_agents=()
  existing_missing_agents=()

  if ! pane_rows="$("$cmux_bin" list-panes --workspace "$target_workspace_ref" 2>/dev/null)"; then
    existing_agent_health_reason="its panes could not be inspected"
    return 2
  fi
  while IFS= read -r row || [[ -n "$row" ]]; do
    [[ -n "$row" ]] && pane_refs+=("$row")
  done < <(printf '%s\n' "$pane_rows" | extract_cmux_refs pane)
  if [[ "${#pane_refs[@]}" -eq 0 ]]; then
    existing_agent_health_reason="it has no inspectable panes"
    return 2
  fi
  for pane_ref in "${pane_refs[@]}"; do
    if ! pane_surface_rows="$("$cmux_bin" --id-format both list-pane-surfaces --workspace "$target_workspace_ref" --pane "$pane_ref" 2>/dev/null)"; then
      existing_agent_health_reason="its agent surfaces could not be inspected"
      return 2
    fi
    while IFS= read -r row || [[ -n "$row" ]]; do
      [[ -n "$row" ]] && all_surface_rows+=("$row")
    done <<<"$pane_surface_rows"
  done
  if [[ "${#all_surface_rows[@]}" -eq 0 ]]; then
    existing_agent_health_reason="its agent surfaces could not be inspected"
    return 2
  fi
  surface_rows="$(printf '%s\n' "${all_surface_rows[@]}")"
  # Each check runs for every chosen agent before the next check starts, so the
  # first reported defect is the same one the fixed Codex + Claude code reported.
  for agent in "${launch_agents[@]}"; do
    agent_name="$(agent_field "$agent" surface_name)"
    agent_refs=()
    agent_ids=()
    while IFS= read -r row || [[ -n "$row" ]]; do
      [[ -n "$row" ]] && agent_refs+=("$row")
    done < <(printf '%s\n' "$surface_rows" | surface_refs_for_name "$agent_name")
    while IFS= read -r row || [[ -n "$row" ]]; do
      [[ -n "$row" ]] && agent_ids+=("$row")
    done < <(printf '%s\n' "$surface_rows" | surface_ids_for_name "$agent_name")
    if [[ "${#agent_refs[@]}" -eq 0 && "${#agent_ids[@]}" -eq 0 ]]; then
      existing_missing_agents+=("$agent")
    elif [[ "${#agent_refs[@]}" -ne 1 || "${#agent_ids[@]}" -ne 1 ]]; then
      surfaces_unique=0
    else
      present_agents+=("$agent")
      agent_var_set "$agent" existing_ref "${agent_refs[0]}"
      agent_var_set "$agent" existing_id "${agent_ids[0]}"
    fi
    expected_surfaces="${expected_surfaces:+$expected_surfaces and }one $agent_name surface"
  done
  if [[ "$surfaces_unique" -ne 1 ]]; then
    existing_agent_health_reason="it does not contain exactly $expected_surfaces"
    return 1
  fi
  # A missing pane is added only for an agent with no live wake. A live wake
  # (say, from a pane that was closed) would make the new one a second wake.
  for agent in ${existing_missing_agents[@]+"${existing_missing_agents[@]}"}; do
    agent_name="$(agent_field "$agent" surface_name)"
    wake_status=0
    agent_wake_lock_live "$target_amq_session" "$agent" || wake_status=$?
    case "$wake_status" in
      0)
        existing_agent_health_reason="it has no $agent_name pane, but $agent still has a live AMQ wake in session $target_amq_session, so a new $agent_name pane would be a second wake. Retire that wake, then launch again"
        return 1
        ;;
      2)
        existing_agent_health_reason="it has no $agent_name pane, and the AMQ wake lock for $agent in session $target_amq_session could not be verified (unreadable lock, or a running process that could not be inspected), so a new $agent_name pane might be a second wake. Check that wake, then launch again"
        return 1
        ;;
    esac
  done
  for agent in ${present_agents[@]+"${present_agents[@]}"}; do
    agent_name="$(agent_field "$agent" surface_name)"
    if ! surface_has_live_runtime "$(agent_var_get "$agent" existing_ref)"; then
      existing_agent_health_reason="its $agent_name surface has no live terminal runtime"
      return 1
    fi
  done
  for agent in ${present_agents[@]+"${present_agents[@]}"}; do
    agent_name="$(agent_field "$agent" surface_name)"
    if ! wake_targets_surface "$target_amq_session" "$agent" "$(agent_var_get "$agent" existing_id)"; then
      existing_agent_health_reason="its $agent_name AMQ wake is not bound to the exact $agent_name surface"
      return 1
    fi
  done

  for agent in ${present_agents[@]+"${present_agents[@]}"}; do
    agent_name="$(agent_field "$agent" surface_name)"
    process_status=0
    surface_has_agent_process "$(agent_var_get "$agent" existing_ref)" "$agent" || process_status=$?
    case "$process_status" in
      0)
        ;;
      1)
        existing_agent_health_reason="its $agent_name surface has no live $agent_name process"
        return 1
        ;;
      *)
        existing_agent_health_reason="its $agent_name process could not be inspected"
        return 2
        ;;
    esac
  done
  return 0
}

handle_existing_workspace_state() {
  local existing_workspace_records
  local workspace_lookup_status=0
  local runtime_status=0
  local agent_health_status=0
  local project_session_active=0
  local candidate_ref
  local candidate_session
  local candidate_kind
  local candidate_reason
  local preferred_reason=""
  local chosen_workspace_ref=""
  local chosen_amq_session=""
  local chosen_kind=""
  local existing_refs_display=""
  local index
  local -a existing_workspace_refs
  local -a existing_amq_sessions
  local -a existing_workspace_kinds
  existing_workspace_refs=()
  existing_amq_sessions=()
  existing_workspace_kinds=()
  if session_in_use "$project"; then
    project_session_active=1
  fi

  existing_workspace_records="$(workspace_records_for_project "$project")" || workspace_lookup_status=$?
  case "$workspace_lookup_status" in
    0)
      ;;
    1)
      existing_workspace_records=""
      ;;
    *)
      echo "Could not query cmux workspaces while checking $project. Refusing to launch until cmux state can be inspected." >&2
      exit 1
      ;;
  esac

  while IFS=$'\t' read -r candidate_ref candidate_session candidate_kind || [[ -n "$candidate_ref" ]]; do
    if [[ -n "$candidate_ref" && -n "$candidate_session" && -n "$candidate_kind" ]]; then
      existing_workspace_refs+=("$candidate_ref")
      existing_amq_sessions+=("$candidate_session")
      existing_workspace_kinds+=("$candidate_kind")
    fi
  done <<<"$existing_workspace_records"

  if [[ "${#existing_workspace_refs[@]}" -gt 0 ]]; then
    for ((index = 0; index < ${#existing_workspace_refs[@]}; index++)); do
      candidate_ref="${existing_workspace_refs[$index]}"
      candidate_session="${existing_amq_sessions[$index]}"
      candidate_kind="${existing_workspace_kinds[$index]}"
      candidate_reason=""
      if [[ "$candidate_kind" == "title-collision" ]]; then
        candidate_reason="its title matches but it has no matching launcher metadata"
      elif ! session_in_use "$candidate_session"; then
        candidate_reason="AMQ session $candidate_session is not active"
      else
        runtime_status=0
        workspace_has_live_runtime "$candidate_ref" || runtime_status=$?
        case "$runtime_status" in
          0)
            ;;
          1)
            candidate_reason="it has no live terminal runtime"
            ;;
          *)
            candidate_reason="its terminal runtime could not be inspected"
            ;;
        esac
        if [[ -z "$candidate_reason" ]]; then
          # The workspace's own room, which can be suffixed, decides its agents.
          resolve_launch_agents "$candidate_session"
          agent_health_status=0
          existing_workspace_agents_ready "$candidate_ref" "$candidate_session" || agent_health_status=$?
          if [[ "$agent_health_status" -ne 0 ]]; then
            candidate_reason="$existing_agent_health_reason"
          fi
        fi
      fi

      if [[ "$index" -eq 0 ]]; then
        preferred_reason="$candidate_reason"
      fi
      if [[ -z "$candidate_reason" ]]; then
        chosen_workspace_ref="$candidate_ref"
        chosen_amq_session="$candidate_session"
        chosen_kind="$candidate_kind"
        break
      fi
    done

    if [[ -z "$chosen_workspace_ref" ]]; then
      chosen_workspace_ref="${existing_workspace_refs[0]}"
      chosen_amq_session="${existing_amq_sessions[0]}"
      chosen_kind="${existing_workspace_kinds[0]}"
      candidate_reason="$preferred_reason"
    fi

    if [[ "${#existing_workspace_refs[@]}" -gt 1 ]]; then
      for candidate_ref in "${existing_workspace_refs[@]}"; do
        if [[ -n "$existing_refs_display" ]]; then
          existing_refs_display="$existing_refs_display, $candidate_ref"
        else
          existing_refs_display="$candidate_ref"
        fi
      done
      echo "Found ${#existing_workspace_refs[@]} launcher matches or title collisions for project $project ($existing_refs_display). Selecting $chosen_workspace_ref and refusing to create another." >&2
    fi

    if [[ "$dry_run" == "1" || "$dry_run" == "true" ]]; then
      printf 'cmux workspace select %q\n' "$chosen_workspace_ref"
    elif ! select_existing_workspace "$chosen_workspace_ref"; then
      echo "Could not select existing cmux workspace $chosen_workspace_ref for $project" >&2
      exit 1
    fi

    if [[ -n "$candidate_reason" ]]; then
      if [[ "$chosen_kind" == "title-collision" ]]; then
        echo "Workspace title $project is already in use by $chosen_workspace_ref, but it has no matching launcher metadata. Opened it for inspection and created nothing." >&2
      else
        echo "Project $project already has cmux workspace $chosen_workspace_ref using AMQ session $chosen_amq_session, but $candidate_reason. Opened it for inspection and refused to create another." >&2
      fi
      exit 1
    fi

    # The workspace is healthy but lacks panes for chosen agents: the main flow
    # adds those panes to it instead of creating a workspace.
    if [[ "${#existing_missing_agents[@]}" -gt 0 ]]; then
      grow_workspace_ref="$chosen_workspace_ref"
      grow_amq_session="$chosen_amq_session"
      return 0
    fi

    if [[ "$dry_run" == "1" || "$dry_run" == "true" ]]; then
      printf 'would reattach %q in %q using AMQ session %q\n' "$project" "$chosen_workspace_ref" "$chosen_amq_session"
      exit 0
    fi
    launch_ok=1
    printf 'Reattached %s in %s using AMQ session %s\n' "$project" "$chosen_workspace_ref" "$chosen_amq_session"
    exit 0
  fi

  if [[ "$project_session_active" -eq 1 ]]; then
    if retire_missing_workspace_session; then
      reuse_project_session=1
      echo "AMQ session $project had no cmux workspace. Retired its detached wakes and will reuse the original mailbox." >&2
    else
      echo "AMQ session $project is already active, but no cmux workspace for project $project was found. Could not safely retire it. Allocating a separate AMQ session instead." >&2
    fi
  fi
}

retire_amq_session() {
  local session="$1"
  local agents="${2:-$launch_retire_csv}"
  local session_root="$amq_base_root/$session"
  local retire_output
  if [[ ! -x "$keepalive_bin" ]]; then
    echo "Safe AMQ retirement helper is unavailable or not executable: $keepalive_bin" >&2
    return 1
  fi
  if [[ "$dry_run" == "1" || "$dry_run" == "true" ]]; then
    printf 'would retire detached AMQ wakes: %q retire-session --root %q --agents %q --adapter cmux --amq %q --self %q\n' \
      "$keepalive_bin" "$session_root" "$agents" "$amq_bin" "$keepalive_bin"
    return 0
  fi
  # Same pipe-free capture as attach_exact_wake: retirement can converge on wakes whose daemons
  # hold an inherited descriptor, and a substitution pipe would block on end-of-file.
  if capture_command_output retire_output \
    "$keepalive_bin" retire-session \
      --root "$session_root" \
      --agents "$agents" \
      --adapter cmux \
      --amq "$amq_bin" \
      --self "$keepalive_bin"; then
    return 0
  fi
  echo "Safe AMQ retirement refused for $session: $retire_output" >&2
  return 1
}

retire_missing_workspace_session() {
  retire_amq_session "$project" "$launch_retire_csv"
}

allocate_amq_session() {
  if [[ "$reuse_project_session" -eq 1 ]]; then
    printf '%s\n' "$project"
    return 0
  fi
  local candidate="$project"
  local n=2
  while session_in_use "$candidate"; do
    candidate="$project-$n"
    n=$((n + 1))
    if (( n > 1000 )); then
      echo "Could not allocate an unused AMQ session for $project after 999 suffixes" >&2
      return 1
    fi
  done
  printf '%s\n' "$candidate"
}

# amq_session_health <session-root> [handle...]: 0 when AMQ's read-only doctor
# passes Config and Mailboxes and each named handle has a configured, healthy
# mailbox; otherwise prints the problems and returns 1.
amq_session_health() {
  local session_root="$1"
  local doctor_output=""
  local doctor_status=0
  shift

  # stderr MUST NOT be merged into stdout here: doctor_output is parsed as JSON, and
  # amq writes an "update available" notice to stderr on every invocation. With 2>&1
  # that notice is prepended to the payload and the parse fails at char 0. Keep the
  # streams apart, and keep stderr only for the failure message.
  local doctor_err_file
  doctor_err_file="$(mktemp)"
  if doctor_output=$("$amq_bin" doctor --root "$session_root" --json --json-schema=2 2>"$doctor_err_file"); then
    rm -f "$doctor_err_file"
  else
    doctor_status=$?
    printf 'amq doctor command failed (exit %d): %s\n' "$doctor_status" "$(cat "$doctor_err_file" 2>/dev/null)"
    rm -f "$doctor_err_file"
    return 1
  fi
  /usr/bin/python3 -c '
import json
import sys

try:
    result = json.load(sys.stdin)
except Exception as exc:
    print(f"amq doctor returned invalid JSON: {exc}")
    raise SystemExit(1)

checks = {entry.get("name"): entry for entry in result.get("checks", [])}
problems = []
for name in ("Config", "Mailboxes"):
    status = checks.get(name, {}).get("status")
    if status != "ok":
        message = checks.get(name, {}).get("message", "check missing")
        display_status = status or "missing"
        problems.append(f"{name}={display_status} ({message})")

mailboxes = {entry.get("handle"): entry for entry in result.get("mailboxes", [])}
for handle in sys.argv[1:]:
    mailbox = mailboxes.get(handle)
    if mailbox is None:
        problems.append(f"required configured mailbox {handle} missing")
        continue
    if mailbox.get("provenance") not in ("configured", "configured_and_discovered"):
        problems.append(f"required mailbox {handle} is not configured")
    if mailbox.get("status") != "ok":
        mailbox_status = mailbox.get("status", "missing")
        problems.append(f"required mailbox {handle} status={mailbox_status}")

if problems:
    print("; ".join(problems))
    raise SystemExit(1)
' "$@" <<<"$doctor_output"
}

# resolve_launch_agents [session]: which agents this launch starts, when the
# project made no choice of its own. An existing room keeps its agents (owner
# decision, 2026-10-04), and a new room starts with the app's Settings default.
# The room is the session the launch will use, which can be a suffixed one such
# as <project>-2. A room handle this launcher cannot start is named and skipped;
# a room with no handle it can start stops the launch. Runs under the project
# lock, before any AMQ or cmux change.
resolve_launch_agents() {
  local session="${1:-$project}"
  local config="$amq_base_root/$session/meta/config.json"
  local handles=""
  local handle
  local known=""
  local unknown=""
  [[ "$agent_choice_explicit" -eq 1 ]] && return 0
  if [[ -f "$config" ]] && handles="$(room_agent_handles "$config")"; then
    while IFS= read -r handle; do
      [[ -n "$handle" ]] || continue
      if agent_field "$handle" surface_name >/dev/null; then
        known="${known:+$known,}$handle"
      else
        unknown="${unknown:+$unknown, }$handle"
      fi
    done <<<"$handles"
    if [[ -z "$known" ]]; then
      echo "AMQ room $session lists no agent this launcher can start (${unknown:-it lists none}). Choose this project's agents in the app's Agents menu, or set CMUX_PROJECT_LAUNCHER_AGENTS. Created nothing." >&2
      exit 1
    fi
    if parse_agent_roster "$known"; then
      if [[ -n "$unknown" ]]; then
        echo "AMQ room $session also lists $unknown, which this launcher cannot start; launching $(launch_agent_names)." >&2
      fi
      return 0
    fi
  fi
  if ! parse_agent_roster "${CMUX_PROJECT_LAUNCHER_DEFAULT_AGENTS-claude,codex}"; then
    echo "CMUX_PROJECT_LAUNCHER_DEFAULT_AGENTS is not a usable agent list: $(agent_roster_reason). Choose one or more of: ${known_agents_roster[*]}. Created nothing." >&2
    exit 2
  fi
}

# plan_room_growth <session>: compares an existing room with the chosen agents.
# Sets room_growth_agents (the room's handles, then the missing ones),
# room_growth_added (the missing ones; empty when none) and room_present_agents
# (chosen agents the room already lists). Returns 1, after saying why, when the
# room cannot be grown. `amq init --force` on AMQ 0.77.3 keeps every mailbox and
# queued message (probed 2026-10-04) but rewrites config.json: it resets
# created_utc and drops any key besides version, created_utc and agents. A room
# with such keys is therefore not grown.
room_growth_agents=""
room_growth_added=""
room_present_agents=()
plan_room_growth() {
  local session="$1"
  local session_root="$amq_base_root/$session"
  local plan=""
  local plan_status=0
  local present
  room_growth_agents=""
  room_growth_added=""
  room_present_agents=()
  plan="$(/usr/bin/python3 - "$session_root/meta/config.json" "${launch_agents_roster[@]}" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], "r", encoding="utf-8") as fh:
        config = json.load(fh)
    agents = config["agents"]
    if not isinstance(agents, list) or not all(isinstance(a, str) for a in agents):
        raise ValueError("agents is not a list of handles")
except Exception:
    # Unreadable: leave the verdict to amq doctor.
    sys.exit(0)
missing = [agent for agent in sys.argv[2:] if agent not in agents]
if not missing:
    sys.exit(0)
extra = sorted(set(config) - {"version", "created_utc", "agents"})
if extra:
    print(",".join(missing) + "\t" + ", ".join(extra))
    sys.exit(3)
present = [agent for agent in sys.argv[2:] if agent in agents]
print(",".join(agents + missing) + "\t" + ",".join(missing) + "\t" + ",".join(present))
PY
)" || plan_status=$?
  if [[ "$plan_status" -eq 3 ]]; then
    echo "AMQ room $session lacks ${plan%%$'\t'*}, but its config also holds ${plan#*$'\t'}, which amq init --force would drop. Add the agents to the room by hand, or choose agents it has. Created nothing." >&2
    return 1
  elif [[ "$plan_status" -ne 0 ]]; then
    echo "Could not read AMQ room $session at $session_root to compare its agents. Created nothing." >&2
    return 1
  fi
  [[ -z "$plan" ]] && return 0
  room_growth_agents="${plan%%$'\t'*}"
  plan="${plan#*$'\t'}"
  room_growth_added="${plan%%$'\t'*}"
  present="${plan#*$'\t'}"
  if [[ -n "$present" ]]; then
    IFS=',' read -r -a room_present_agents <<<"$present"
  fi
}

# add_room_agents <session>: runs the growth plan_room_growth computed.
add_room_agents() {
  local session="$1"
  local session_root="$amq_base_root/$session"
  local grow_output=""
  local grow_status=0
  if grow_output=$("$amq_bin" init --root "$session_root" --agents "$room_growth_agents" --force 2>&1); then
    :
  else
    grow_status=$?
    echo "Could not add ${room_growth_added//,/, } to AMQ room $session (exit $grow_status): $grow_output. Created nothing." >&2
    return 1
  fi
  echo "Added ${room_growth_added//,/, } to AMQ room $session." >&2
}

ensure_amq_session_initialized() {
  local session="$1"
  local session_root="$amq_base_root/$session"
  local init_output=""
  local health_output=""
  local init_status=0

  if [[ -f "$session_root/meta/config.json" ]]; then
    if ! plan_room_growth "$session"; then
      return 1
    fi
    if [[ -z "$room_growth_added" ]]; then
      if health_output=$(amq_session_health "$session_root" "${launch_agents_roster[@]}"); then
        return 0
      fi
      echo "AMQ session $session at $session_root failed read-only AMQ doctor validation; refusing to modify it or create a cmux workspace: $health_output" >&2
      return 1
    fi
    # Judge the room as it stands, for the chosen agents it already has, before
    # amq init --force rewrites it.
    if ! health_output=$(amq_session_health "$session_root" ${room_present_agents[@]+"${room_present_agents[@]}"}); then
      echo "AMQ session $session at $session_root failed read-only AMQ doctor validation; refusing to modify it or create a cmux workspace: $health_output" >&2
      return 1
    fi
    # A dry run does not grow the room, so doctor would miss the new mailboxes.
    if [[ "$dry_run" == "1" || "$dry_run" == "true" ]]; then
      printf 'would add %s to AMQ session: %q init --root %q --agents %q --force\n' \
        "$room_growth_added" "$amq_bin" "$session_root" "$room_growth_agents"
      printf 'would validate AMQ session %q with amq doctor after the growth\n' "$session"
      return 0
    fi
    if ! add_room_agents "$session"; then
      return 1
    fi
    if ! health_output=$(amq_session_health "$session_root" "${launch_agents_roster[@]}"); then
      echo "Added ${room_growth_added//,/, } to AMQ room $session, but read-only AMQ doctor validation then failed; refusing to create a cmux workspace: $health_output" >&2
      return 1
    fi
    return 0
  fi
  if [[ "$dry_run" == "1" || "$dry_run" == "true" ]]; then
    printf 'would initialize AMQ session: %q init --root %q --agents %q\n' \
      "$amq_bin" "$session_root" "$launch_roster_csv,user"
    return 0
  fi
  if init_output=$("$amq_bin" init --root "$session_root" --agents "$launch_roster_csv,user" 2>&1); then
    :
  else
    init_status=$?
    echo "Could not initialize AMQ session $session at $session_root (exit $init_status): $init_output" >&2
    return 1
  fi
  if ! health_output=$(amq_session_health "$session_root" "${launch_agents_roster[@]}"); then
    echo "AMQ initialized session $session at $session_root but read-only AMQ doctor validation failed; refusing to create a cmux workspace: $health_output" >&2
    return 1
  fi
}

if ! amq_base_root="$(resolve_amq_base_root)" || [[ -z "$amq_base_root" ]]; then
  echo "Could not resolve AMQ base root for session allocation." >&2
  exit 1
fi
if ! acquire_project_launch_lock; then
  exit 1
fi
resolve_launch_agents
if ! amq_who_state="$(amq_who_json "$amq_base_root")"; then
  echo "Could not inspect AMQ sessions. Refusing to guess an unused session." >&2
  exit 1
fi
handle_existing_workspace_state
if [[ -n "$grow_workspace_ref" ]]; then
  amq_session="$grow_amq_session"
else
  amq_session="$(allocate_amq_session)"
  # A new workspace can get a suffixed room; that room decides its agents too.
  if [[ "$amq_session" != "$project" ]]; then
    resolve_launch_agents "$amq_session"
  fi
fi
if ! ensure_amq_session_initialized "$amq_session"; then
  exit 1
fi
# From here on a growing launch runs only the agents it adds: their panes are
# the only ones started, attached, named and given a start prompt, and the only
# ones closed and retired if the launch fails.
if [[ -n "$grow_workspace_ref" ]]; then
  growing_workspace=1
  parse_agent_roster "$(IFS=,; printf '%s' "${existing_missing_agents[*]}")"
fi

# One (pane name, launcher word, boot name, startup) group per chosen agent, in
# pipeline order. The boot name is empty unless the agent is named by a boot flag.
layout_agent_args=()
for agent in "${launch_agents[@]}"; do
  agent_boot_name=""
  if [[ "$(agent_field "$agent" rename_mode)" == "boot-flag" ]]; then
    agent_boot_name="$agent-$amq_session"
  fi
  layout_agent_args+=(
    "$(agent_field "$agent" surface_name)"
    "$(agent_var_get "$agent" launcher)"
    "$agent_boot_name"
    "$(agent_field "$agent" startup)"
  )
done

# A new workspace needs the layout JSON. A growing launch needs each new pane's
# command, one per line, built by the same code so both start agents alike.
pane_plan_mode=layout
if [[ "$growing_workspace" -eq 1 ]]; then
  pane_plan_mode=commands
fi
pane_plan=$(
  /usr/bin/python3 - "$pane_plan_mode" "$amq_session" "$workspace_root" "${layout_agent_args[@]}" <<'PY'
import json
import shlex
import sys

mode, amq_session, workspace_root = sys.argv[1:4]
agent_args = sys.argv[4:]
# The launcher words are zsh functions/aliases in ~/.zshrc, so load them through zsh -ic.
# Claude gets `--name claude-<session>` at boot. The explicit `--` follows the
# portable amq_claude grammar and forwards the remaining args to `claude`, so the
# conversation is named before /start and the name survives /clear. Codex has no
# equivalent boot flag; it is renamed post-boot.
def launch_inner(launcher, extra_args=""):
    env = {
        # AMQ 0.47 binds wakes to a live owner and no longer supports deferred
        # wake manifests. The launcher disables the early SessionStart hook,
        # starts each TUI with no wake, then attaches both exact surface UUIDs
        # after cmux reports that the agent runtimes are live.
        "AMQ_COOP_WAKE_FLAG": "--no-wake",
        "AMQ_KEEPALIVE_DISABLED": "1",
    }
    prefix = " ".join(f"{key}={shlex.quote(value)}" for key, value in env.items())
    command = f"{prefix} {shlex.quote(launcher)} {shlex.quote(amq_session)}"
    if extra_args:
        command += " " + extra_args
    return command

panes = []
commands = []
for index in range(0, len(agent_args), 4):
    surface_name, launcher, boot_name, startup = agent_args[index:index + 4]
    if startup == "helper":
        # A coop helper runs exactly as typed: in cmux its bootstrap defaults to
        # --no-wake and attaches the wake to this pane itself once the agent is up.
        inner = f"{shlex.quote(launcher)} {shlex.quote(amq_session)}"
    else:
        extra_args = "-- --name " + shlex.quote(boot_name) if boot_name else ""
        inner = launch_inner(launcher, extra_args)
    # When an oh-my-zsh update is due, an interactive zsh with no typed input
    # waiting asks "Would you like to update? [Y/n]" and the agent never starts.
    # DISABLE_AUTO_UPDATE turns that check off for this inner shell only.
    command = f"cd {shlex.quote(workspace_root)} && DISABLE_AUTO_UPDATE=true zsh -ic {shlex.quote(inner)}"
    commands.append(command)
    surface = {
        "type": "terminal",
        "name": surface_name,
        "command": command,
    }
    if not panes:
        surface["focus"] = True
    panes.append({"pane": {"surfaces": [surface]}})

if mode == "commands":
    print("\n".join(commands))
    sys.exit(0)

def row(cells):
    # Equal columns from nested two-way splits.
    if len(cells) == 1:
        return cells[0]
    return {
        "direction": "horizontal",
        "split": round(1 / len(cells), 4),
        "children": [cells[0], row(cells[1:])],
    }

# cmux 0.64.25 accepts a bare pane as the layout root and nested splits up to
# five panes (both probed 2026-10-04). Up to three agents share one row; four
# are two over two, and five are three over two.
if len(panes) <= 3:
    layout = row(panes)
elif len(panes) <= 5:
    top = (len(panes) + 1) // 2
    layout = {
        "direction": "vertical",
        "split": 0.5,
        "children": [row(panes[:top]), row(panes[top:])],
    }
else:
    sys.exit(f"no pane layout is defined for {len(panes)} agents")
print(json.dumps(layout, separators=(",", ":")))
PY
)

layout=""
pane_commands=()
if [[ "$growing_workspace" -eq 1 ]]; then
  while IFS= read -r row || [[ -n "$row" ]]; do
    [[ -n "$row" ]] && pane_commands+=("$row")
  done <<<"$pane_plan"
  if [[ "${#pane_commands[@]}" -ne "${#launch_agents[@]}" ]]; then
    echo "Could not plan the $(launch_agent_names) pane commands for $grow_workspace_ref: $pane_plan" >&2
    exit 1
  fi
else
  layout="$pane_plan"
fi

if [[ "$dry_run" == "1" || "$dry_run" == "true" ]]; then
  if [[ "$growing_workspace" -eq 1 ]]; then
    for ((index = 0; index < ${#launch_agents[@]}; index++)); do
      printf 'cmux new-pane --workspace %q --direction right --command %q --focus false\n' \
        "$grow_workspace_ref" "${pane_commands[$index]}"
      printf 'cmux rename-tab --workspace %q --surface <new surface> %q\n' \
        "$grow_workspace_ref" "$(agent_field "${launch_agents[$index]}" surface_name)"
    done
  else
    printf 'cmux workspace create --name %q --description %q --layout %q --focus true\n' \
      "$project" "Project launcher: $project (AMQ session: $amq_session)" "$layout"
  fi
  printf 'allocated AMQ session: %q\n' "$amq_session"
  for agent in "${launch_agents_roster[@]}"; do
    agent_name="$(agent_field "$agent" surface_name)"
    case "$(agent_field "$agent" rename_mode)" in
      boot-flag)
        printf '%s session name (boot --name): %q\n' "$agent_name" "$agent-$amq_session"
        ;;
      post-boot)
        printf 'post-boot %s rename: %q then %q + send-key enter\n' "$agent_name" "/rename" "$agent-$amq_session"
        ;;
      helper)
        printf '%s starts through %q, which attaches its own AMQ wake; no start command\n' \
          "$agent_name" "$(agent_var_get "$agent" launcher)"
        ;;
    esac
  done
  if [[ "$no_start" -eq 1 ]]; then
    printf 'no-start mode: workspace + rename only, no start commands sent\n'
  else
    for agent in "${launch_agents[@]}"; do
      [[ "$(agent_field "$agent" startup)" == "launcher" ]] || continue
      printf 'post-boot %s send: %q + sleep %q + send-key enter, retry up to %q\n' \
        "$(agent_field "$agent" surface_name)" "$(agent_field "$agent" start_command) $project" "$enter_delay_seconds" "$enter_retries"
    done
  fi
  exit 0
fi

# add_agent_pane <agent> <command>: splits a new pane off the live workspace,
# names it like a layout pane so the next launch finds it, and records its
# surface ref and id. cmux 0.64.25 prints "OK surface:N pane:M workspace:W" for
# new-pane, and a rename-tab name stays when the agent sets its own terminal
# title (both probed 2026-10-05).
add_agent_pane() {
  local agent="$1"
  local pane_command="$2"
  local agent_name
  local added_output
  local added_surface
  local added_pane
  local rename_output
  local pane_rows
  local row
  local -a named_refs
  local -a named_ids
  named_refs=()
  named_ids=()
  agent_name="$(agent_field "$agent" surface_name)"
  if ! added_output="$("$cmux_bin" new-pane --workspace "$workspace_ref" --direction right --command "$pane_command" --focus false 2>&1)"; then
    echo "Could not add a $agent_name pane to $workspace_ref: $added_output" >&2
    return 1
  fi
  added_surface="$(printf '%s\n' "$added_output" | extract_cmux_refs surface | head -n 1)"
  added_pane="$(printf '%s\n' "$added_output" | extract_cmux_refs pane | head -n 1)"
  # Track any surface cmux named before judging the rest, so a pane created
  # with output we cannot parse is still closed if the growth fails.
  if [[ -n "$added_surface" ]]; then
    grow_added_surfaces+=("$added_surface")
  fi
  if [[ "$added_output" != OK* || -z "$added_surface" || -z "$added_pane" ]]; then
    echo "Unexpected cmux new-pane output for $agent_name in $workspace_ref: $added_output" >&2
    return 1
  fi
  if ! rename_output="$("$cmux_bin" rename-tab --workspace "$workspace_ref" --surface "$added_surface" "$agent_name" 2>&1)"; then
    echo "Could not name the new $agent_name pane $added_surface in $workspace_ref: $rename_output" >&2
    return 1
  fi
  if ! pane_rows="$("$cmux_bin" --id-format both list-pane-surfaces --workspace "$workspace_ref" --pane "$added_pane" 2>&1)"; then
    echo "cmux list-pane-surfaces failed for $workspace_ref/$added_pane: $pane_rows" >&2
    return 1
  fi
  while IFS= read -r row || [[ -n "$row" ]]; do
    [[ -n "$row" ]] && named_refs+=("$row")
  done < <(printf '%s\n' "$pane_rows" | surface_refs_for_name "$agent_name")
  while IFS= read -r row || [[ -n "$row" ]]; do
    [[ -n "$row" ]] && named_ids+=("$row")
  done < <(printf '%s\n' "$pane_rows" | surface_ids_for_name "$agent_name")
  if [[ "${#named_refs[@]}" -ne 1 || "${#named_ids[@]}" -ne 1 || "${named_refs[0]}" != "$added_surface" ]]; then
    echo "The new pane $added_surface in $workspace_ref did not take the name $agent_name: $pane_rows" >&2
    return 1
  fi
  agent_var_set "$agent" surface "$added_surface"
  agent_var_set "$agent" surface_id "${named_ids[0]}"
}

if [[ "$growing_workspace" -eq 1 ]]; then
  workspace_ref="$grow_workspace_ref"
  for ((index = 0; index < ${#launch_agents[@]}; index++)); do
    if ! add_agent_pane "${launch_agents[$index]}" "${pane_commands[$index]}"; then
      exit 1
    fi
  done
else
  created=$("$cmux_bin" workspace create \
    --name "$project" \
    --description "Project launcher: $project (AMQ session: $amq_session)" \
    --layout "$layout" \
    --focus true)

  workspace_ref="${created#OK }"
  if [[ -z "$workspace_ref" || "$workspace_ref" == "$created" ]]; then
    echo "Unexpected cmux workspace create output: $created" >&2
    exit 1
  fi

  # NOTE: bash 3.2 (the system /bin/bash a GUI-launched .app resolves via PATH) has no
  # `mapfile`/`readarray`, so these use the portable current-shell read loop. The
  # `|| [[ -n "$row" ]]` keeps a final newline-less line, matching `mapfile -t`.
  surface_rows=()
  surface_rows_output=""
  if ! surface_rows_output="$(workspace_surface_rows "$workspace_ref" both)"; then
    echo "Could not inspect $(launch_agent_names) surfaces in $workspace_ref" >&2
    exit 1
  fi
  while IFS= read -r row || [[ -n "$row" ]]; do
    [[ -n "$row" ]] && surface_rows+=("$row")
  done <<<"$surface_rows_output"

  # Each chosen agent owns exactly one surface, found by its pane name. The ref and
  # the id land in <agent>_surface and <agent>_surface_id.
  surfaces_resolved=1
  for agent in "${launch_agents[@]}"; do
    agent_name="$(agent_field "$agent" surface_name)"
    agent_surfaces=()
    while IFS= read -r row || [[ -n "$row" ]]; do
      agent_surfaces+=("$row")
    done < <(printf '%s\n' "${surface_rows[@]}" | surface_refs_for_name "$agent_name")
    agent_surface_ids=()
    while IFS= read -r row || [[ -n "$row" ]]; do
      agent_surface_ids+=("$row")
    done < <(printf '%s\n' "${surface_rows[@]}" | surface_ids_for_name "$agent_name")
    if [[ "${#agent_surfaces[@]}" -ne 1 || "${#agent_surface_ids[@]}" -ne 1 ]]; then
      surfaces_resolved=0
    else
      agent_var_set "$agent" surface "${agent_surfaces[0]}"
      agent_var_set "$agent" surface_id "${agent_surface_ids[0]}"
    fi
  done

  if [[ "$surfaces_resolved" -ne 1 ]]; then
    echo "Could not resolve unique $(launch_agent_names) surface refs/ids by name in $workspace_ref" >&2
    printf 'Surface rows:\n' >&2
    printf '%s\n' "${surface_rows[@]}" >&2
    "$cmux_bin" list-panes --workspace "$workspace_ref" >&2 || true
    "$cmux_bin" list-pane-surfaces --workspace "$workspace_ref" >&2 || true
    exit 1
  fi
fi

agent_readiness_error() {
  local reason="$1"
  local agent
  local agent_name
  local start_commands=""
  local sessions_phrase="both agent sessions are"
  local surface_lines=""
  local debug_blocks=""
  local screen_blocks=""
  local refusal
  local created_phrase
  local helper_note=""
  if [[ "${#launch_agents[@]}" -eq 1 ]]; then
    sessions_phrase="the agent session is"
  elif [[ "${#launch_agents[@]}" -gt 2 ]]; then
    sessions_phrase="all agent sessions are"
  fi
  for agent in "${launch_agents[@]}"; do
    agent_name="$(agent_field "$agent" surface_name)"
    if [[ "$(agent_field "$agent" startup)" == "helper" ]]; then
      surface_lines="$surface_lines$agent_name surface: $(agent_var_get "$agent" surface), expected: an AMQ wake for $agent on cmux:surface:$(agent_var_get "$agent" surface_id), attached by $(agent_var_get "$agent" launcher)"$'\n'
      helper_note=$'\n'"A helper-started agent attaches its own wake after its banner appears;
its coop bootstrap logs the attempt to ~/Library/Logs/CmuxProjectLauncher/launcher.log."
    else
      start_commands="${start_commands:+$start_commands or }$(agent_field "$agent" start_command)"
      surface_lines="$surface_lines$agent_name surface: $(agent_var_get "$agent" surface), expected screen regex: $(agent_var_get "$agent" ready_regex)"$'\n'
    fi
    debug_blocks="$debug_blocks"$'\n'"$agent_name debug:"$'\n'"$(surface_debug_block "$(agent_var_get "$agent" surface)")"$'\n'
    screen_blocks="$screen_blocks"$'\n'"$agent_name screen:"$'\n'"$(read_surface_text "$(agent_var_get "$agent" surface)" || true)"$'\n'
  done
  refusal="Refusing to send $start_commands until $sessions_phrase confirmed."
  if [[ -z "$start_commands" ]]; then
    refusal="Refusing to report a launch until $sessions_phrase confirmed."
  fi
  if [[ "$growing_workspace" -eq 1 ]]; then
    created_phrase="cmux added $(launch_agent_names) to $workspace_ref"
  else
    created_phrase="cmux created $workspace_ref"
  fi
  cat >&2 <<ERR
$created_phrase, but the $(launch_agent_names /) tabs did not pass readiness checks.
$reason
$refusal

AMQ session: $amq_session
${surface_lines}
If a screen dump below shows only zsh, inspect the --no-wake boot command.
A visible agent banner instead indicates a readiness-regex
or startup-timing mismatch, not a failed wake registration.${helper_note}
Close stale cmux workspaces or restart cmux, then try again.
Set CMUX_PROJECT_LAUNCHER_KEEP_FAILED_WORKSPACE=1 to keep the failed workspace.
${debug_blocks}${screen_blocks%$'\n'}
ERR
}

ensure_surface_runtime() {
  local surface="$1"
  if surface_has_live_runtime "$surface"; then
    return 0
  fi
  promote_surface_once "$surface"
  wait_for_surface_runtime "$surface"
}

agent_not_ready_reason=""
wait_agent_ready() {
  # 0 = the surface has a live runtime AND shows the agent's boot banner; 1 = not ready,
  # with the cause left in agent_not_ready_reason for the caller's diagnostics.
  local surface="$1"
  local ready_regex="$2"
  agent_not_ready_reason=""
  if ! ensure_surface_runtime "$surface"; then
    agent_not_ready_reason="cmux reported no live terminal tty for $surface"
    return 1
  fi
  if wait_for_surface_text "$surface" "$ready_regex"; then
    return 0
  fi
  sleep "$wait_seconds"
  if wait_for_surface_text "$surface" "$ready_regex"; then
    return 0
  fi
  agent_not_ready_reason="$surface never showed a banner matching $ready_regex"
  return 1
}

# All helper agents share one wake deadline, set when their wait starts, so a
# launch with several stuck helpers fails after one poll period, not one each.
helper_wake_deadline=""
wait_helper_wake() {
  # A helper-started agent is ready once its bootstrap's AMQ wake is a live
  # `amq wake` for this room and agent that injects into this exact surface.
  # The banner is the bootstrap's own condition, so it is not checked here.
  local agent="$1"
  local surface="$2"
  local surface_id="$3"
  local deadline
  agent_not_ready_reason=""
  if ! ensure_surface_runtime "$surface"; then
    agent_not_ready_reason="cmux reported no live terminal tty for $surface"
    return 1
  fi
  [[ -n "$helper_wake_deadline" ]] || helper_wake_deadline=$((SECONDS + poll_seconds))
  deadline="$helper_wake_deadline"
  while true; do
    if wake_targets_surface "$amq_session" "$agent" "$surface_id"; then
      return 0
    fi
    (( SECONDS >= deadline )) && break
    sleep 1
  done
  agent_not_ready_reason="no AMQ wake for $agent on cmux:surface:$surface_id appeared within ${poll_seconds}s"
  return 1
}

attach_exact_wake() {
  local agent="$1"
  local surface_id="$2"
  local attach_output
  if [[ ! -x "$keepalive_bin" ]]; then
    echo "AMQ wake unavailable for $agent: helper is not executable: $keepalive_bin" >&2
    return 1
  fi
  # Capture through a file, not command substitution: the wake daemon this registers keeps an
  # inherited pipe descriptor open for the session's lifetime, so a substitution pipe here never
  # reaches end-of-file and the launcher hangs after an otherwise successful launch.
  # 2026-08-06: a prequeued message proved that an unbaselined wake can inject its automatic
  # doorbell before the Codex naming handshake. Baseline the startup cohort here; the explicit
  # notify_existing_backlog step below emits exactly one doorbell after naming completes.
  if ! capture_command_output attach_output \
    /usr/bin/env -u AMQ_WAKE_OWNER AMQ_KEEPALIVE_BASELINE_EXISTING=1 \
      "$keepalive_bin" reattach \
      --adapter cmux \
      --target "cmux:surface:$surface_id" \
      --root "$amq_base_root/$amq_session" \
      --base-root "$amq_base_root" \
      --session "$amq_session" \
      --me "$agent" \
      --amq "$amq_bin" \
      --self "$keepalive_bin" \
      --wake-ready-timeout 10s; then
    echo "AMQ wake unavailable for $agent on cmux surface $surface_id: $attach_output" >&2
    return 1
  fi
  if [[ "$attach_output" == *"warning:"* ]]; then
    echo "AMQ wake attachment warning for $agent on cmux surface $surface_id: $attach_output" >&2
  fi
  return 0
}

notify_existing_backlog() {
  local agent="$1"
  local surface_id="$2"
  local unread_json
  local unread_count
  local payload="[AMQ] Unread messages are queued. Run: amq drain --include-body"

  if ! unread_json="$(
    "$amq_bin" list \
      --root "$amq_base_root/$amq_session" \
      --me "$agent" \
      --new \
      --limit 1 \
      --json 2>>"$diagnostics_log"
  )"; then
    echo "AMQ backlog inspection failed for $agent after exact wake attachment. Messages remain queued." >&2
    return 1
  fi
  if ! unread_count="$(
    printf '%s' "$unread_json" |
      /usr/bin/python3 -c 'import json, sys; value = json.load(sys.stdin); assert isinstance(value, list); print(len(value))'
  )"; then
    echo "AMQ backlog inspection returned invalid JSON for $agent. Messages remain queued." >&2
    return 1
  fi
  if [[ "$unread_count" -eq 0 ]]; then
    return 0
  fi
  if ! "$keepalive_bin" inject cmux "cmux:surface:$surface_id" "$payload" >>"$diagnostics_log" 2>&1; then
    echo "AMQ backlog doorbell failed for $agent on cmux surface $surface_id. Messages remain queued." >&2
    return 1
  fi
  return 0
}

# In --no-start (ad-hoc) mode the scratch workspace is the deliverable, so once its
# surfaces resolve we keep it regardless of any later readiness/rename outcome.
if [[ "$no_start" -eq 1 ]]; then
  launch_ok=1
fi

# A helper agent's wake is its readiness, so a ready helper agent is attached.
for agent in "${launch_agents[@]}"; do
  agent_var_set "$agent" ready 0
  agent_var_set "$agent" attached 0
  agent_var_set "$agent" not_ready_reason ""
  if [[ "$(agent_field "$agent" startup)" == "helper" ]]; then
    if wait_helper_wake "$agent" "$(agent_var_get "$agent" surface)" "$(agent_var_get "$agent" surface_id)"; then
      agent_var_set "$agent" ready 1
      agent_var_set "$agent" attached 1
    else
      agent_var_set "$agent" not_ready_reason "$agent_not_ready_reason"
    fi
  elif wait_agent_ready "$(agent_var_get "$agent" surface)" "$(agent_var_get "$agent" ready_regex)"; then
    agent_var_set "$agent" ready 1
  else
    agent_var_set "$agent" not_ready_reason "$agent_not_ready_reason"
  fi
done

if [[ "$no_start" -ne 1 ]]; then
  for agent in "${launch_agents[@]}"; do
    if [[ "$(agent_var_get "$agent" ready)" -ne 1 ]]; then
      agent_name="$(agent_field "$agent" surface_name)"
      if [[ "$(agent_field "$agent" startup)" == "helper" ]]; then
        agent_readiness_error "$agent_name surface $(agent_var_get "$agent" surface) did not get its AMQ wake from $(agent_var_get "$agent" launcher): $(agent_var_get "$agent" not_ready_reason)."
      else
        agent_readiness_error "$agent_name surface $(agent_var_get "$agent" surface) did not obtain a live runtime or show a recognized $agent_name banner."
      fi
      exit 1
    fi
  done
fi

# Attach each ready agent on its own. 2026-09-23 Gate 4: cmux never reported a
# tty for the Codex surface, and requiring both agents here left the ready
# Claude pane without a wake as well, so the room had zero wakes.
# A refused attach for one agent must not skip the other either: try every
# ready agent first, then fail naming each refusal (2026-09-23 /audit F3).
# Helper agents were attached by their own bootstrap.
attach_failed_agents=()
for agent in "${launch_agents[@]}"; do
  [[ "$(agent_field "$agent" startup)" == "launcher" ]] || continue
  if [[ "$(agent_var_get "$agent" ready)" -eq 1 ]]; then
    if attach_exact_wake "$agent" "$(agent_var_get "$agent" surface_id)"; then
      agent_var_set "$agent" attached 1
    else
      attach_failed_agents+=("$agent")
    fi
  fi
done
if [[ "${#attach_failed_agents[@]}" -gt 0 ]]; then
  # An attached wake was already baselined. Surface its pre-existing queue
  # before exiting so a one-sided attach failure cannot suppress that backlog.
  # A helper agent's bootstrap surfaces its own backlog.
  for agent in "${launch_agents[@]}"; do
    [[ "$(agent_field "$agent" startup)" == "launcher" ]] || continue
    if [[ "$(agent_var_get "$agent" attached)" -eq 1 ]] && ! notify_existing_backlog "$agent" "$(agent_var_get "$agent" surface_id)"; then
      echo "$(agent_field "$agent" surface_name) wake attached, but its queued AMQ messages could not be surfaced after another attachment failed." >&2
    fi
  done
  for failed_agent in "${attach_failed_agents[@]}"; do
    echo "Workspace $workspace_ref is live, but exact AMQ wake attachment failed for $failed_agent." >&2
  done
  launch_ok=1
  echo "Messages remain queued; no start prompts were sent." >&2
  exit 1
fi

# Name the Codex thread post-boot. Claude was named at boot via
# `claude --name claude-<session>` in the layout, so it needs no post-boot rename.
rename_failed=0
for agent in "${launch_agents[@]}"; do
  agent_var_set "$agent" renamed 0
  [[ "$(agent_field "$agent" rename_mode)" == "post-boot" ]] || continue
  agent_name="$(agent_field "$agent" surface_name)"
  if [[ "$(agent_var_get "$agent" ready)" -eq 1 ]]; then
    if rename_thread "$(agent_var_get "$agent" surface)" "$agent-$amq_session" "$agent"; then
      agent_var_set "$agent" renamed 1
    elif [[ "$no_start" -ne 1 ]]; then
      launch_ok=1
      echo "Workspace $workspace_ref is live, but $agent_name did not confirm the name $agent-$amq_session. No start prompts were sent." >&2
      rename_failed=1
    else
      echo "Could not confirm the $agent_name thread was renamed to $agent-$amq_session; preserving the ad-hoc workspace." >&2
    fi
  else
    echo "Skipping $agent_name rename because its surface did not become ready." >&2
  fi
done

# rename_thread dismisses the dialog on its own failure paths, but the modal can
# render AFTER that check and leave Codex sitting on "Type a name and press Enter",
# where it cannot receive an AMQ doorbell. Observed live 2026-09-08 as Gate 4 run C:
# the launcher reported a naming warning and exited 0 with the pane still blocked.
# Re-verify here, escape whatever is still open, and refuse to claim a clean launch
# if the pane stays blocked.
for agent in "${launch_agents[@]}"; do
  agent_var_set "$agent" pane_blocked 0
  [[ "$(agent_field "$agent" rename_mode)" == "post-boot" ]] || continue
  if [[ "$(agent_var_get "$agent" ready)" -eq 1 && "$(agent_var_get "$agent" renamed)" -ne 1 ]]; then
    if ! dismiss_rename_dialog "$(agent_var_get "$agent" surface)" "$agent" "$agent-$amq_session"; then
      agent_var_set "$agent" pane_blocked 1
    fi
  fi
done

# Surface queued work only after the Codex naming handshake is finished. An
# earlier doorbell can be consumed as rename input and leave both operations in
# an ambiguous state. A helper agent's bootstrap surfaces its own backlog.
backlog_ok=1
for agent in "${launch_agents[@]}"; do
  [[ "$(agent_field "$agent" startup)" == "launcher" ]] || continue
  if [[ "$(agent_var_get "$agent" attached)" -eq 1 ]] && ! notify_existing_backlog "$agent" "$(agent_var_get "$agent" surface_id)"; then
    backlog_ok=0
    break
  fi
done
if [[ "$backlog_ok" -ne 1 ]]; then
  launch_ok=1
  echo "Workspace $workspace_ref is live, but queued AMQ messages could not be surfaced. No start prompts were sent." >&2
  exit 1
fi

for agent in "${launch_agents[@]}"; do
  if [[ "$(agent_var_get "$agent" pane_blocked)" -eq 1 ]]; then
    launch_ok=1
    echo "$(agent_field "$agent" surface_name) is stuck in its rename dialog on $(agent_var_get "$agent" surface) and cannot receive AMQ messages; press escape in that pane. Preserving $workspace_ref." >&2
    exit 1
  fi
done

if [[ "$rename_failed" -eq 1 ]]; then
  exit 1
fi

# Only --no-start reaches this point with an agent that never became ready.
# Exiting 0 here reported a launched room that had no working AMQ wake.
attach_incomplete=0
for agent in "${launch_agents[@]}"; do
  if [[ "$(agent_var_get "$agent" attached)" -ne 1 ]]; then
    attach_incomplete=1
    agent_not_ready_detail="$(agent_var_get "$agent" not_ready_reason)"
    echo "$(agent_field "$agent" surface_name) AMQ wake was not attached: ${agent_not_ready_detail:-its surface did not become ready}. Messages to $agent remain queued." >&2
  fi
done
if [[ "$attach_incomplete" -eq 1 ]]; then
  launch_ok=1
  echo "Preserving $workspace_ref, but the launch is incomplete. No start prompts were sent." >&2
  exit 1
fi

if [[ "$no_start" -eq 1 ]]; then
  launch_ok=1
  # Naming summary in roster order: what each launched agent's session name rests on.
  naming_complete=1
  naming_summary=""
  for agent in "${launch_agents_roster[@]}"; do
    agent_name="$(agent_field "$agent" surface_name)"
    case "$(agent_field "$agent" rename_mode)" in
      boot-flag)
        [[ "$(agent_var_get "$agent" ready)" -eq 1 ]] || naming_complete=0
        naming_summary="$naming_summary$agent_name name requested at boot; "
        ;;
      post-boot)
        [[ "$(agent_var_get "$agent" renamed)" -eq 1 ]] || naming_complete=0
        naming_summary="$naming_summary$agent_name rename confirmed; "
        ;;
      helper)
        [[ "$(agent_var_get "$agent" ready)" -eq 1 ]] || naming_complete=0
        naming_summary="$naming_summary$agent_name started by $(agent_var_get "$agent" launcher); "
        ;;
    esac
  done
  if [[ "$naming_complete" -eq 1 ]]; then
    echo "Launched ad-hoc workspace $amq_session in $workspace_ref (${naming_summary}no /start sent)"
  else
    echo "Launched ad-hoc workspace $amq_session in $workspace_ref (session naming incomplete; no /start sent)"
  fi
  exit 0
fi

for agent in "${launch_agents[@]}"; do
  [[ "$(agent_field "$agent" startup)" == "launcher" ]] || continue
  start_command="$(agent_field "$agent" start_command)"
  if ! submit_prompt "$(agent_var_get "$agent" surface)" "$start_command $project" "$agent"; then
    launch_ok=1
    echo "Launched $project in $workspace_ref using AMQ session $amq_session, but could not confirm $(agent_field "$agent" surface_name) submitted $start_command." >&2
    exit 1
  fi
done

launch_ok=1
if [[ "$growing_workspace" -eq 1 ]]; then
  echo "Added $(launch_agent_names) to $project in $workspace_ref using AMQ session $amq_session"
else
  echo "Launched $project in $workspace_ref using AMQ session $amq_session"
fi
